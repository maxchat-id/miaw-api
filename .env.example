# Server Configuration
PORT=3000
HOST=0.0.0.0

# Public base URL shown in the /docs API reference (optional).
# Use `{subdomain}` to expose an editable subdomain field in the docs UI.
# PUBLIC_SERVER_URL=https://{subdomain}.maxchat.id
# PUBLIC_SERVER_SUBDOMAIN=api

# API Key (single key for all requests)
API_KEY=your-secret-api-key-here

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-here
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=1000
# Hosts exempt from the webhook SSRF check (comma-separated; `host` = any port,
# `host:port` = that port only). Use for co-located consumers, e.g. localhost:4000
# WEBHOOK_SSRF_ALLOWLIST=localhost:4000

# CORS
CORS_ORIGIN=*

# Session Storage
SESSION_PATH=./sessions

# Default history sync for instances that do not set `syncFullHistory`
# themselves. WhatsApp pushes the whole archive on a first connect; on staging
# that blocked HTTP for 17m38s and wrote 8476 session key files while adding
# nothing to the database. `false` keeps the bootstrap/recent batches — which
# still carry the initial @lid mappings — and drops only the FULL sync.
# Unset leaves miaw-core's default (full sync on). A per-instance
# `clientOptions.syncFullHistory` always wins.
# MIAW_SYNC_FULL_HISTORY=false

# Optional Proxy Pool
# Mount this file as a secret. Supported formats: TXT, JSON.
# MIAW_PROXY_FILE=/run/secrets/miaw-proxies.txt
MIAW_PROXY_STRATEGY=deterministic

# Logging
LOG_LEVEL=info
